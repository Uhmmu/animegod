            "value": "下载"
          }
        }
      }
    },
    "Downloads you start on your Mac show up here, and can be paused from your phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で開始したダウンロードがここに表示され、iPhone から一時停止できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上开始的下载会出现在这里，可以从手机暂停。"
          }
        }
      }
    },
    "Episode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エピソード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧集"
          }
        }
      }
    },
    "Episode %@ next": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次は第 %@ 話"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一集是第 %@ 集"
          }
        }
      }
    },
    "Episode %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Episode %1$@ · %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %@ 話 · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %@ 集 · %@"
          }
        }
      }
    },
    "Episodes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エピソード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧集"
          }
        }
      }
    },
    "Episodes you download play with no network at all — the Mac does not need to be awake, or anywhere near you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたエピソードはネットワークなしで再生できます — Mac が起動している必要も、近くにある必要もありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载过的剧集完全不用网络就能播 —— Mac 不必开着，也不必在你附近。"
          }
        }
      }
    },
    "Episodes you have started show up here, at the position your Mac left them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中まで見たエピソードが、Mac で止めた位置のまま表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看过一部分的剧集会出现在这里，位置就是 Mac 上停下的地方。"
          }
        }
      }
    },
    "Every transport produces the same thing: an address that reaches your Mac. They are all raced at once and the first to answer wins — a filled dot is the one carrying this connection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの経路も得られる結果は同じです。Mac に届くアドレスが一つ手に入るだけです。すべて同時に試され、最初に応答したものが使われます — 塗りつぶされた点が現在の接続です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种传输方式产出的东西都一样：一个能连到你 Mac 的地址。它们会被同时发起竞速，谁先应答谁获胜 —— 实心圆点就是当前这条连接走的路。"
          }
        }
      }
    },
    "Finished": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已看完"
          }
        }
      }
    },
    "Found nearby": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くで見つかりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在附近找到的"
          }
        }
      }
    },
    "From your Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac から"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你的 Mac"
          }
        }
      }
    },
    "Full": {
