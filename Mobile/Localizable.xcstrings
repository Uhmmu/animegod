{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ is watching this episode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がこのエピソードを再生中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在看这一集。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld episodes · %@. Excluded from iCloud backup — they are copies of files that live on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld episodes · %2$@. Excluded from iCloud backup — they are copies of files that live on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld エピソード · %@。iCloud バックアップからは除外されています — Mac にある元ファイルの複製だからです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 集 · %@。已排除在 iCloud 备份之外 —— 它们只是 Mac 上文件的副本。"
          }
        }
      }
    },
    "%lld of %lld watched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld watched"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld 話 視聴済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已看 %lld 集，共 %lld 集"
          }
        }
      }
    },
    "%lld peers": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ピア"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个节点"
          }
        }
      }
    },
    "%lld ratings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の評価"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 人评分"
          }
        }
      }
    },
    "%lld waiting": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件待機中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个等待中"
          }
        }
      }
    },
    "000000": {
      "shouldTranslate": false
    },
    "192.168.1.10:47380": {
      "shouldTranslate": false
    },
    "A positive delay shows subtitles later. Size applies to plain-text subtitles always, and to styled ones without disturbing their colours or signs.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値は字幕を遅らせます。サイズはテキスト字幕には常に適用され、スタイル付き字幕にも色や特殊効果を変えずに適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值让字幕更晚出现。大小对纯文本字幕始终有效，对带样式的字幕也会生效，且不会动它的颜色和特效字。"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Already Playing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在播放"
          }
        }
      }
    },
    "Anime": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画"
          }
        }
      }
    },
    "AnimeGod on your Mac holds the library. Pair with it to browse here and pick up where you left off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは Mac の AnimeGod にあります。ペアリングすると、ここで閲覧し、続きから再生できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体库在 Mac 上的 AnimeGod 里。配对之后就能在这里浏览，并从上次停下的地方接着看。"
          }
        }
      }
    },
    "Area": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示領域"
