    "Colored as White": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーコメントを白で表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩色弹幕显示为白色"
          }
        }
      }
    },
    "Comments fill from the top down, so this keeps the rest of the picture clear — subtitles included.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメントは上から順に並ぶため、画面の残りを空けておけます — 字幕も含めて。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹幕从上往下排，所以这项能让画面其余部分保持干净 —— 字幕也在内。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きを見る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续观看"
          }
        }
      }
    },
    "Could not reach your Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に接続できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上你的 Mac。"
          }
        }
      }
    },
    "Could not reach your Mac. Is AnimeGod open on it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に接続できませんでした。AnimeGod は起動していますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上你的 Mac。它上面的 AnimeGod 打开了吗？"
          }
        }
      }
    },
    "Could not reach your Mac. Is AnimeGod open on it? Off your own network, add its Tailscale address in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に接続できませんでした。AnimeGod は起動していますか？自分のネットワーク外からは、設定で Tailscale アドレスを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上你的 Mac。它上面的 AnimeGod 打开了吗？不在自己的网络里时，到设置里填上它的 Tailscale 地址。"
          }
        }
      }
    },
    "Could not start the playback engine.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生エンジンを起動できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动播放引擎。"
          }
        }
      }
    },
