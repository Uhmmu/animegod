<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Read-write so a torrent file can be saved where the user picks
         (and, later, downloads written to a chosen folder). Library
         folders are still only ever read. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
	<!-- AnimeGod is distributed outside the Mac App Store. Keep external
	     volumes writable across launches even when a previously issued
	     security-scoped bookmark can no longer be resolved. Directory
	     exceptions must end with a slash. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/Volumes/</string>
	</array>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The embedded BitTorrent engine listens for incoming peers; being
	     connectable is the single biggest factor in download speed. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- MPVKit embeds LuaJIT for mpv's built-in scripts. Under the hardened
	     runtime, LuaJIT's generated code is otherwise killed as an invalid
	     executable page as soon as playback initializes. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
