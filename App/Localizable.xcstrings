          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "· %lld 个待确认"
          }
        }
      }
    },
    "· Translated": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "· 翻訳済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "· 已翻译"
          }
        }
      }
    },
    "· checked %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "· %@ にチェック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "· %@检查过"
          }
        }
      }
    },
    "· in order": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "· 順番どおり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "· 按顺序"
          }
        }
      }
    },
    "· next around %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
