        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消订阅这部番剧？"
          }
        }
      }
    },
    "Stop sharing this one, and leave the rest sharing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これだけ共有を止め、ほかはそのまま続ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只停止分享这一项，其余继续"
          }
        }
      }
