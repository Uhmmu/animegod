    "—": {
      "shouldTranslate": false
    },
    "— the right episode, but not from the fansub this season was started with": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "— 話数は合っていますが、このシーズンを始めた字幕組ではありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "—— 集数没错，但不是本季最初用的字幕组"
          }
        }
      }
    },
    "“%@”": {
      "shouldTranslate": false
    },
    "“%@” has finished, but its files are no longer where it left them. It is paused rather than downloaded again — move them back, or resume it to fetch them afresh.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は完了していますが、ファイルが当時の場所にありません。再ダウンロードせず一時停止しました — ファイルを戻すか、再開して取得し直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已下载完成，但文件已不在当时的位置。已暂停，而不是重新下载——把文件挤回原处，或者继续任务重新获取。"
          }
        }
      }
    },
    "“%@” has no Blu-ray video on it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には再生できる Blu-ray 映像がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”里没有可播放的蓝光影片。"
          }
        }
      }
    },
    "“%@” is a DVD image. AnimeGod plays Blu-ray images only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は DVD イメージです。AnimeGod が再生できるのは Blu-ray イメージだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是 DVD 镜像。AnimeGod 只能播放蓝光镜像。"
          }
        }
      }
    },
    "“%@” is already in Downloads.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでにダウンロードにあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在下载列表中。"
          }
        }
      }
    },
    "“%@” is not a catalogue number. They look like ANZX-10294 or BRMM-10716.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は品番ではありません。品番は ANZX-10294 や BRMM-10716 のような形式です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是品番。品番长这样：ANZX-10294、BRMM-10716。"
          }
        }
      }
    },
    "“%@” is not a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はフォルダではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是文件夹。"
          }
        }
      }
    },
    "“%@” is not connected — cached episodes still play; the rest need the drive plugged in.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は接続されていません — キャッシュしたエピソードは再生できますが、それ以外はドライブが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未连接——已缓存的剧集仍可播放；其余需要接上硬盘。"
          }
        }
      }
    },
    "“%@” is not readable — connect its drive before caching.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を読み込めません — キャッシュする前にドライブを接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无法读取——请先连接硬盘再缓存。"
          }
        }
      }
    },
    "“%@” is not there right now — is the drive plugged in?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が見つかりません — ドライブは接続されていますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”目前不在——硬盘接上了吗？"
          }
        }
      }
    },
    "“%@” will stop checking for new episodes. Downloads it already started are kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は新しい話のチェックをやめます。開始済みのダウンロードは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将不再检查新剧集。已开始的下载会保留。"
          }
        }
      }
    },
    "“%@” will stop downloading. Files already written can be kept or deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のダウンロードを停止します。書き込み済みのファイルは残すか削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将停止下载。已写入的文件可以保留或删除。"
          }
        }
      }
    },
    "“%@” → %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” → %2$@: %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」→ %@：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」→ %@：%@"
          }
        }
      }
    },
    "“%@”: %lld releases need a look — another fansub or another encode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@”: %2$lld releases need a look — another fansub or another encode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」：%lld 件の資源に確認が必要です — 別の字幕組または別のエンコードです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」：有 %lld 个资源需要确认 —— 来自其他字幕组或其他压制。"
          }
        }
      }
    },
    "“%@”: nothing new (%lld releases checked)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@”: nothing new (%2$lld releases checked)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」：新着なし（%2$lld件のリリースを確認）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”：没有新内容（检查了 %2$lld 个资源）"
          }
        }
      }
    }
  },
  "version": "1.0"
}
