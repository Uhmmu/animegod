    "Subscribed, new episode %lld percent downloaded": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済み、新しい話のダウンロード %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
