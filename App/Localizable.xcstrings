    "Match Metadata": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータをマッチ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配元数据"
          }
        }
      }
    },
    "Match this local title with Bangumi or AniList to add artwork, synopsis, sourced ratings, and community reviews.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカル作品を Bangumi または AniList とマッチすると、画像・あらすじ・評価・コミュニティのレビューが追加されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这个本地作品与 Bangumi 或 AniList 匹配，即可添加封面、简介、评分和社区评论。"
          }
        }
      }
    },
    "Match weighs episode, release group and source (BD/WEB timing) first, then your language and format order.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致度はまず話数・リリースグループ・ソース（BD/WEB のタイミング）を重視し、次に言語と形式の順位を見ます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配度首先看集数、字幕组和片源（BD/WEB 时间轴），然后才看你设置的语言和格式顺序。"
          }
        }
      }
    },
    "Match “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をマッチ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配“%@”"
          }
        }
      }
    },
    "Matched %lld source(s). %@ could not be reached; cached metadata and the local library remain available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Matched %1$lld source(s). %2$@ could not be reached; cached metadata and the local library remain available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld件のソースとマッチしました。%2$@ に接続できませんでしたが、キャッシュ済みのメタデータとローカルライブラリは引き続き使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已匹配 %1$lld 个来源。%2$@ 无法访问；已缓存的元数据和本地资料库仍可正常使用。"
          }
        }
      }
    },
    "Matched %lld source(s). %@ stopped answering: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Matched %1$lld source(s). %2$@ stopped answering: %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のソースを照合しました。%@ が応答しなくなりました：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已匹配 %lld 个来源。%@ 不再响应：%@"
          }
        }
      }
    },
    "Matched Anime: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched Anime: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched Anime: %@"
          }
        }
      }
    },
    "Matched Episode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マッチしたエピソード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已匹配的剧集"
          }
        }
      }
    },
    "Matches AnimeGod could not make on its own appear here. It looks for metadata by itself after every scan, so this fills in without being asked.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod が自力で決められなかった照合がここに表示されます。スキャンのたびに自動でメタデータを探すので、頼まなくても埋まっていきます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod 自己拿不准的匹配会出现在这里。每次扫描后它都会自动查找元数据，所以这里不用你动手就会填上。"
          }
        }
      }
    },
    "Matching episodes download on their own — one release per episode, never one already in your library or downloaded before, and always under the speed limit for automatic downloads in Settings. Anything that fits the show but not this rule is offered on this page instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件に合う話は自動でダウンロードされます — 1 話につき 1 件だけ、ライブラリにある話や以前ダウンロードした話は決して取らず、常に設定の自動ダウンロード速度制限のもとで行われます。作品には合うがこのルールに合わないものは、このページで確認を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符合条件的剧集会自动下载 —— 每集只取一个资源，绝不重复下载媒体库里已有或此前下载过的，并且始终遵守设置中的自动下载速度限制。符合这部番剧但不符合本规则的资源，会在本页面列出来等你确认。"
          }
        }
      }
    },
    "Matching episodes download on their own — one release per episode, never one already in your library or downloaded before. Everything it does is listed under Recent Activity.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件に合うエピソードは自動でダウンロードされます — 1話につき1リリースで、ライブラリにあるものや以前ダウンロードしたものは除きます。動作はすべて「最近のアクティビティ」に記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符合条件的剧集会自动下载——每集只下载一个资源，资料库里已有或以前下载过的不会重复下载。所有操作都会列在“最近动态”中。"
          }
        }
      }
    },
