    "Subscribe to a set to have its next episodes download on their own": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットを登録すると、その後の話が自動でダウンロードされます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅某个剧集合辑，之后的剧集就会自动下载"
          }
        }
      }
    },
    "Subscribed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已订阅"
          }
        }
