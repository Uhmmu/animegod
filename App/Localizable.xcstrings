    "Add a Discogs API key in Settings to look covers and catalogue numbers up.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カバーと品番を調べるには、設定で Discogs の API キーを登録してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置里填入 Discogs API 密钥，才能查封面和品番。"
          }
        }
      }
    },
    "Add a folder to turn local video files into an anime library.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを追加すると、ローカルの動画ファイルがアニメライブラリになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个文件夹，把本地视频文件整理成番剧资料库。"
          }
        }
      }
    },
    "Add by Hand": {
