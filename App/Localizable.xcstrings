    "Subscribed, a new episode is ready": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済み、新しい話が届いています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已订阅，有新剧集可以看了"
          }
        }
      }
