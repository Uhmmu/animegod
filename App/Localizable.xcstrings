    "AnimeGod can no longer read this file. Remove and re-add its library folder to renew access.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod はこのファイルを読み込めなくなりました。ライブラリフォルダを削除して追加し直すと、アクセス権が更新されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod 无法再读取这个文件。请移除并重新添加它所在的资料库文件夹以恢复访问权限。"
          }
        }
      }
    },
    "AnimeGod can read “%@” but not write to it: this library folder was authorised for reading only. Use “Choose Folder…” and pick it again to allow downloads into it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod は「%@」を読み込めますが書き込めません。このライブラリフォルダは読み取り専用で許可されています。「フォルダを選択…」で選び直すと、ダウンロードできるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod 可以读取“%@”但无法写入：这个资料库文件夹当初只授权了读取。请使用“选择文件夹…”重新选择它，以允许下载到其中。"
          }
        }
      }
    },
    "AnimeGod is not allowed to write to “%@”. Use “Choose Folder…” and pick it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod には「%@」への書き込み権限がありません。「フォルダを選択…」で選び直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod 没有写入“%@”的权限。请使用“选择文件夹…”重新选择它。"
          }
        }
      }
    },
