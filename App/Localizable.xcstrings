    "dandanplay AppId": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dandanplay AppId"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹弹play AppId"
          }
        }
      }
    },
    "dandanplay AppSecret": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dandanplay AppSecret"
          }
        },
        "zh-Hans": {
