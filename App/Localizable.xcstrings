    "Stored in AnimeGod's own local settings, outside the library and outside the project.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnimeGod 自身のローカル設定に保存されます。ライブラリの中でもプロジェクトの中でもありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
