    "Downloads that finish appear here and go on sharing themselves until you remove them or switch this off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが完了した資源はここに並び、削除するかシードをオフにするまで共有を続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载完成的资源会出现在这里，并持续分享，直到你把它移除或关闭做种。"
          }
        }
      }
    },
    "Downloads the pieces in order so the episode can be played before it finishes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピースを順番にダウンロードするので、完了前に再生できます"
