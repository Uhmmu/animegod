    "No verified torrent file is available for this release. Use its magnet link instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースには確認済みのトレントファイルがありません。マグネットリンクを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个资源没有经过验证的种子文件。请改用它的磁力链接。"
          }
        }
      }
    },
    "Nobody published %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は未公開"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无人发布 %@"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无"
          }
        }
      }
    },
    "None of the sources had a match. Try another alias or check Source Details.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのソースにも一致しませんでした。別名を試すか「ソースの詳細」を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有来源都没有结果。试试其他别名，或查看“来源详情”。"
          }
        }
      }
    },
    "Not Sharing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在分享"
          }
        }
      }
    },
    "Not Started": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未視聴"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未看"
          }
        }
      }
    },
    "Not a Concert": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブではない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是演唱会"
          }
        }
      }
    },
    "Not connected — entries stay indexed; playback needs the drive or a cached copy.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未接続 — 項目は残ります。再生にはドライブかキャッシュが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接——条目仍保留在索引中；播放需要连接硬盘或有缓存。"
          }
        }
      }
    },
    "Not enough free space on this Mac to cache “%@”.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の空き容量が足りないため「%@」をキャッシュできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的可用空间不足，无法缓存“%@”。"
          }
        }
      }
    },
    "Not running": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未运行"
          }
        }
      }
    },
    "Not started (time limit)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未開始（時間切れ）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开始（已到时限）"
          }
        }
      }
    },
    "Nothing Downloading": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード中の項目はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有正在下载的剧集"
          }
        }
      }
    },
    "Nothing Followed Yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も登録していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有订阅任何番剧"
          }
        }
      }
    },
    "Nothing Playing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の項目はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有正在播放的内容"
          }
        }
      }
    },
    "Nothing cached": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有缓存"
          }
        }
      }
    },
    "Nothing came back for “%@”. Try another spelling, or skip and match it later from the anime's page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」では何も見つかりませんでした。別の表記で試すか、スキップして後から作品ページで紐づけてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜「%@」没有结果。换个写法试试，或者跳过，以后在番剧页面里匹配。"
          }
        }
      }
    },
    "Nothing followed yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録はまだありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无订阅"
          }
        }
      }
    },
    "Nothing in Progress": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴途中の作品はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有看到一半的剧集"
          }
        }
      }
    },
    "Nothing is being uploaded. Finished downloads stay on disk and stop sharing, and a download that completes from now on stops as soon as it finishes.\n\nSharing is how a swarm survives: every episode downloaded here came from someone who left theirs running. It costs upload bandwidth for as long as AnimeGod is open, so it is yours to switch on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、何もアップロードしていません。完了したダウンロードはディスクに残りますが共有は止まり、これから完了するものも終わった瞬間に停止します。\n\n共有は群（スウォーム）が生き延びる仕組みそのものです。ここで落ちてきた一話も、誰かが自分の分を動かし続けてくれたおかげで届いています。AnimeGod を開いている間ずっとアップロード帯域を使うので、オンにするかどうかはあなたが決めてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有上传任何数据。已完成的下载仍留在磁盘上，但不再分享；从现在起完成的下载也会在完成的那一刻停止。\n\n分享是一个种子群能活下去的原因：这里下载到的每一集，都来自某个让自己的副本一直挂着的人。只要 AnimeGod 开着，它就会占用上传带宽，所以开不开由你决定。"
          }
        }
      }
    },
    "Nothing is known about it beyond the folder it arrived in, so there is no setlist to lay over it. Discs are matched by the catalogue number in the folder name — ANZX-10294, BRMM-10716.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクについては、入っていたフォルダ以外に手がかりがないため、重ねるセットリストもありません。照合はフォルダ名の品番（ANZX-10294、BRMM-10716）で行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除了它所在的文件夹，关于这张碟一无所知，所以也没有曲目表可以对上去。识别靠文件夹名里的品番 —— ANZX-10294、BRMM-10716。"
          }
        }
      }
    },
    "Nothing new was matched. %lld lookup(s) failed; cached metadata and the local library remain available.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新たに照合できたものはありません。%lld 件の検索に失敗しました。キャッシュ済みのメタデータとローカルライブラリはそのまま使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配到新内容。%lld 次查询失败；已缓存的元数据和本地资料库仍可正常使用。"
          }
        }
      }
    },
    "Nothing to Review": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するものはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要审核的内容"
          }
        }
      }
    },
    "Nothing to Share Yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ共有するものがありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有可分享的内容"
          }
        }
      }
    },
    "Nothing to import.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込むものはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可导入的内容。"
          }
        }
      }
    },
    "Nothing watched in %@ yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@年はまだ何も見ていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 年还没有观看记录。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Off by default. Sharing is how a swarm stays alive — every episode here came from someone who left theirs running — but it uses upload bandwidth for as long as AnimeGod is open, so it is yours to switch on. What is being shared, and how much, is in the Seeding section.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定ではオフです。共有は群（スウォーム）が生き延びる仕組みそのもので、ここにある一話一話も誰かが自分の分を動かし続けてくれた結果ですが、AnimeGod を開いている間ずっとアップロード帯域を使うため、オンにするかどうかはあなたが決めてください。何をどれだけ共有しているかは「シード」セクションにあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。分享是一个种子群能活下去的原因——这里的每一集都来自某个让自己的副本一直挂着的人——但只要 AnimeGod 开着，它就会占用上传带宽，所以开不开由你决定。正在分享什么、上传了多少，都在「做种」栏目里。"
          }
        }
      }
    },
    "Official site": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式サイト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方网站"
          }
        }
      }
    },
    "One chapter per song": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 チャプター 1 曲"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一章一首"
          }
        }
      }
    },
    "One line per song, each with the time it starts. A `DAY1` or `Disc 2` line splits the nights, and `Encore` marks what follows it — but none of that is required, and a list that simply starts over at a lower time is read as the next disc.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行 1 曲、それぞれ開始時間を添えてください。`DAY1` や `Disc 2` だけの行で公演を分け、`Encore` 以降はアンコール扱いになります。いずれも必須ではなく、時間が巻き戻った箇所は次のディスクとして読みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一首，每行带它开始的时间。单独一行写 `DAY1` 或 `Disc 2` 可以分开场次，`Encore` 之后的算安可 —— 但这些都不是必须的，时间突然变小的地方会被当作下一张碟。"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线"
          }
        }
      }
    },
    "Online Subtitles": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン字幕"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线字幕"
          }
        }
      }
    },
    "Online subtitles need a provider key — Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン字幕にはサービスのキーが必要です — 設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线字幕需要服务密钥——请前往设置"
          }
        }
      }
    },
    "Online subtitles: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン字幕：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线字幕：%@"
          }
        }
      }
    },
    "Online subtitles: waiting for the video": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン字幕：動画を待機中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线字幕：等待视频加载"
          }
        }
      }
    },
    "Only Show %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のみ表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示 %@"
          }
        }
      }
    },
    "Only download releases that match": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件に合うリリースのみダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只下载符合以下条件的资源"
          }
        }
      }
    },
    "Only for keys saved by earlier builds. macOS may ask for your password once per key; they are then removed from the Keychain.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のバージョンで保存したキー用です。キーごとに一度パスワードを求められることがあり、その後キーチェーンから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于旧版本保存的密钥。macOS 可能会为每个密钥询问一次密码，之后它们会从钥匙串中移除。"
          }
        }
      }
    },
    "Only releases that bring an episode your library doesn't have": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリにない話を含むリリースのみ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示能补上资料库缺少剧集的资源"
          }
        }
      }
    },
    "Opacity %lld%%": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明度 %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明度 %lld%%"
          }
        }
      }
    },
    "Open Listing Page": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掲載ページを開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开发布页"
          }
        }
      }
    },
    "Open an anime, edit your entry, and assign it a ranking. Rankings stay separate from scores.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメを開いて記録を編集し、順位を付けてください。順位は評価とは別に管理されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一部番剧，编辑你的记录并给它排名。排名与评分相互独立。"
          }
        }
      }
    },
    "Open in Another Torrent App": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のトレントアプリで開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 BT 客户端中打开"
          }
        }
      }
    },
    "Open on %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上打开"
          }
        }
      }
    },
    "Open on Bangumi": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangumi で開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Bangumi 上打开"
          }
        }
      }
    },
    "OpenSubtitles API key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSubtitles API キー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSubtitles API 密钥"
          }
        }
      }
    },
    "OpenSubtitles password (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSubtitles パスワード（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSubtitles 密码（可选）"
          }
        }
      }
    },
    "OpenSubtitles username (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSubtitles ユーザー名（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSubtitles 用户名（可选）"
          }
        }
      }
    },
    "Opening video…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を開いています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开视频…"
          }
        }
      }
    },
    "Order the grid by name, by when it was added, by the average of the ratings its sources gave it, or split it into finished, still watching and not started": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前順・追加順・各ソースの評価の平均で並べ替えるか、見終わった／視聴中／未視聴の3つに分けて表示します"
