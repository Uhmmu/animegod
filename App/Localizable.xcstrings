    "%@ Downloading to the app's own folder instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 代わりにアプリ専用のフォルダへダウンロードします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将改为下载到 App 自己的文件夹。"
          }
        }
      }
    },
    "%@ Downloading to “%@” instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Downloading to “%2$@” instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 代わりに「%2$@」へダウンロードします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将改为下载到“%2$@”。"
          }
        }
      }
    },
    "%@ has nothing under this name. Try another spelling — its romaji or English title often works.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはこの名前の項目がありません。別の表記で試してください — ローマ字や英語題ならたいてい見つかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上没有这个名字的条目。换个写法试试——罗马音或英文名通常能搜到。"
          }
        }
      }
    },
    "%@ is downloading": {
      "localizations": {
